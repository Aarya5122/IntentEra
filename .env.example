# =============================================================================
# IntentEra Jira RAG - Example environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` for local development.
# In AWS Lambda, set these values via the Lambda console's environment
# variables OR reference them through AWS Secrets Manager.
#
# Values marked with (SECRET) should ideally live in AWS Secrets Manager when
# running in the cloud. They are listed here ONLY to aid local development.
# =============================================================================

# ----- Runtime / mode selection -----
# "incremental" (default) or "full". EventBridge will leave this unset so we
# default to incremental. Operators flip SYNC_MODE=full for a forced rebuild.
SYNC_MODE=incremental

# NODE_ENV toggles dev niceties such as pretty logging.
NODE_ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ----- Incremental sync window -----
# How many minutes to subtract from the last successful sync start time to form
# the effective start window. See docs for rationale.
INCREMENTAL_LOOKBACK_MINUTES=60

# ----- Jira scope filters -----
# Comma-separated list of Jira project keys to ingest. Empty = all projects.
JIRA_PROJECT_KEYS=PROJ,ENG
# Comma-separated issue types. Empty = all types.
JIRA_ISSUE_TYPES=
# Comma-separated statuses. Empty = all statuses.
JIRA_STATUSES=
# Comma-separated labels. Empty = no label filter.
JIRA_LABELS=

# Whether to follow linked issues (true/false).
JIRA_INCLUDE_LINKED_ISSUES=true
# Whether to index attachments (true/false).
JIRA_INCLUDE_ATTACHMENTS=true
# Whether to follow Confluence remote links (true/false).
JIRA_INCLUDE_CONFLUENCE=true

# ----- Jira (SECRET) -----
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-with-jira-api-token

# ----- Confluence (SECRET) -----
# Often the same Atlassian account. Leave empty if Jira creds are reused.
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# ----- MongoDB Atlas Vector Search (SECRET) -----
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true
MONGODB_DATABASE=intentera
MONGODB_COLLECTION=rag_chunks
MONGODB_VECTOR_INDEX=vector_index

# ----- Redis (SECRET for password) -----
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=intentera:sync:

# ----- OpenAI embeddings (SECRET) -----
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Dimensions must match the Atlas vector index. 1536 for text-embedding-3-small.
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=64

# ----- AWS Secrets Manager -----
# When USE_SECRETS_MANAGER=true, the loader will read this secret and merge
# its JSON keys into process.env BEFORE the config validator runs.
USE_SECRETS_MANAGER=false
SECRETS_MANAGER_SECRET_ID=intentera/rag/prod
AWS_REGION=us-east-1

# ----- Chunking (optional overrides) -----
CHUNK_DESCRIPTION_MAX_TOKENS=500
CHUNK_DESCRIPTION_OVERLAP_TOKENS=50
CHUNK_COMMENT_GROUP_SIZE=3
CHUNK_ATTACHMENT_MAX_TOKENS=500
CHUNK_CONFLUENCE_MAX_TOKENS=600

# ----- Retrieval defaults -----
RETRIEVAL_DEFAULT_TOP_K=8
RETRIEVAL_MAX_TOP_K=25
